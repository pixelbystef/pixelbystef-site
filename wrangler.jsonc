{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixelbystef-site",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker sees every request first (www/new redirects, client galleries), then serves static files.
    "run_worker_first": true
  },
  "send_email": [
    { "name": "EMAIL", "destination_address": "pixelbystef@gmail.com" }
  ],
  // Client gallery files (photos, films, gallery settings) live in this private R2 bucket.
  "r2_buckets": [
    { "binding": "GALLERIES", "bucket_name": "pixelbystef-galleries" }
  ],
  "vars": {
    // SHA-256 of the gallery admin key (the key itself stays on Stefan's Mac).
    "GALLERY_ADMIN_HASH": "deadbc6ae63c9184fda70b626160b69d9a1a54bcde1b0d4cf9c4add3611d4b7a"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "observability": { "enabled": true }
}
